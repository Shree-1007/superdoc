# Mock LLM mode: uses deterministic responses so tests run without API keys
MOCK_LLM=true

# Logging
LOG_LEVEL=INFO

# Directories
WATCHED_DIR=./documents
RULES_DIR=./rules

# Optional: Real LLM keys (only needed when MOCK_LLM=false)
# OPENAI_API_KEY=sk-...
# GOOGLE_API_KEY=...

# SQLite checkpoint database path
CHECKPOINT_DB=./checkpoints/agent_state.db
